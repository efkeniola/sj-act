<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash / launch theme — uses the ACT red launch background.
         Shown from process start until Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Normal theme — transparent window background so Flutter paints
         its own background immediately, preventing white flash. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
