<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>SJ ACT</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>com.sj_act</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>sj_act</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- Portrait only on iPhone; iPad can also use landscape -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

	<!-- ── Microphone ────────────────────────────────────────────────────
	     Required by:
	       - speech_to_text: spoken-answer detection ("say A, B, C, or D")
	       - record: audio capture for WiFi Challenge voice (if enabled)
	     Apple rejects apps that list this key without using the mic. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>SJ ACT uses your microphone so you can speak your answer aloud ("A", "B", "C", or "D") during practice sessions, and for voice chat during WiFi Challenge.</string>

	<!-- ── Speech recognition ───────────────────────────────────────────
	     Required by speech_to_text for on-device + cloud STT on iOS. -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>SJ ACT uses speech recognition to detect your spoken answer choice during practice. All recognition happens on-device when possible.</string>

	<!-- ── Local network + Bonjour (WiFi Challenge NSD) ─────────────────
	     Required for NSD peer-to-peer discovery on iOS 14+.
	     Without these, the system will block all multicast/Bonjour
	     traffic silently and the WiFi Challenge room scan will always
	     return zero results. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>SJ ACT uses your local network to discover and connect to nearby WiFi Challenge sessions hosted by friends on the same network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_sjact._tcp</string>
	</array>
</dict>
</plist>
